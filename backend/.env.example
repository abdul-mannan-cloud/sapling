DATABASE_URL="file:./dev.db"
PORT=3001

JWT_SECRET="dev-only-secret-change-me"
SEED_ADMIN_PASSWORD="admin123"
SEED_PATIENT_PASSWORD="alex123"

# Leave empty to run the deterministic rule-based agent (no external API calls).
# Set to enable the LLM-powered agent instead.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Server-side only — never exposed to the frontend. Leave empty to disable
# the voice channel (text still works fully without it).
DEEPGRAM_API_KEY=""
